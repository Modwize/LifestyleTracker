# Public Supabase config — safe to ship to the client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Used as the magic-link redirect base when a request lacks an Origin header
# (rare; Vercel typically supplies it). Set to your production origin.
NEXT_PUBLIC_SITE_URL=https://healthwize.vercel.app

# Web Push — VAPID public key. Safe to expose to the client.
# Generate with: npx web-push generate-vapid-keys
# The matching VAPID_PRIVATE_KEY + VAPID_SUBJECT live only in Supabase env vars
# (see root .env.example).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
