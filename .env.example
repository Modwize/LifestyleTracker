# Copy to .env and fill in. .env is gitignored.
# These are ALSO configured as Supabase Edge Function secrets via:
#   supabase secrets set --env-file .env

# ---- Supabase (auto-injected inside Edge Functions; put here for local scripts) ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # server-only, NEVER ship to client

# ---- Oura ----
# Personal Access Token (NOT OAuth client secret). Create at
# https://cloud.ouraring.com/personal-access-tokens
OURA_PAT=

# ---- Telegram Bot ----
# 1) Message @BotFather → /newbot → copy token
TELEGRAM_BOT_TOKEN=
# 2) Random high-entropy string. Telegram echoes this back in the
#    X-Telegram-Bot-Api-Secret-Token header so we can verify inbound webhooks.
#    Register once:
#      curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#        -d "url=https://<ref>.supabase.co/functions/v1/telegram-webhook" \
#        -d "secret_token=$TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_WEBHOOK_SECRET=

# ---- Apple Shortcuts ----
# Random high-entropy string. The iPhone Shortcut sends this as header
# X-Shortcut-Secret. Rotate if exposed.
APPLE_SHORTCUT_SHARED_SECRET=

# ---- Bloodwork LLM extraction (Anthropic Claude) ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional. Defaults to the latest Claude model the extraction function targets.
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-6

# ---- Web Push (VAPID, RFC 8292) ----
# Generate once per environment. In the web/ directory:
#   npx web-push generate-vapid-keys
# Or via openssl (see docs/SETUP.md).
# The public key is ALSO exposed to the browser as NEXT_PUBLIC_VAPID_PUBLIC_KEY
# in the web/.env.local.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL or mailto: for push service providers (required by spec).
VAPID_SUBJECT=mailto:you@example.com
